      "source": [
        "## 3. Validating Our Risk-Score Thresholds\n",
        "\n",
        "`src/client_risk.py` currently classifies a client's payment history as:\n",
        "\n",
        "| Tier | Rule |\n",
        "|---|---|\n",
        "| Low | avg days late ≤ 2 |\n",
        "| Medium | avg days late ≤ 10 |\n",
        "| High | avg days late > 10 |\n",
        "\n",
        "These started as reasonable-sounding defaults. Let's check where they actually fall on the real distribution, and how many clients land in each tier.\n"
      ],
      "id": "lzMPPROJODqE"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "5I9ttQfqODqE"
      },
      "outputs": [],
      "source": [
        "for cutoff in [2, 10]:\n",
        "    pct = (df[\"DaysLate\"] <= cutoff).mean() * 100\n",
        "    print(f\"DaysLate <= {cutoff}: {pct:.1f}% of all invoices fall at or under this\")\n"
      ],
      "id": "5I9ttQfqODqE"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "NDzmC3hzODqE"
      },
      "outputs": [],
      "source": [
        "snapshot_date = df[\"SettledDate\"].max().strftime(\"%Y-%m-%d\")\n",
        "risk_df = compute_client_risk(df, snapshot_date)\n",
        "\n",
        "print(f\"Snapshot date used: {snapshot_date}\")\n",
        "print(f\"Clients scored: {len(risk_df)}\\n\")\n",
        "print(risk_df[\"risk_level\"].value_counts())\n"
      ],
      "id": "NDzmC3hzODqE"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "bNG4ZIJsODqE"
      },
      "outputs": [],
      "source": [
        "fig, ax = plt.subplots()\n",
        "risk_df[\"avg_days_late\"].plot(kind=\"hist\", bins=30, ax=ax, color=\"#2F6F68\", edgecolor=\"white\")\n",
        "for cutoff, label in [(2, \"Low/Medium cutoff\"), (10, \"Medium/High cutoff\")]:\n",
        "    ax.axvline(cutoff, color=\"#B3382C\", linestyle=\"--\")\n",
        "    ax.text(cutoff + 0.3, ax.get_ylim()[1]*0.9, label, rotation=90, fontsize=8)\n",
        "ax.set_title(\"Client-level avg_days_late, with current risk thresholds marked\")\n",
        "ax.set_xlabel(\"Average days late per client\")\n",
        "plt.show()\n"
      ],
      "id": "bNG4ZIJsODqE"
